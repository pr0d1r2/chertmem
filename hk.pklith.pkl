push: Mapping<String, Config.Step> = new {
  ["test"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'test: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v cargo-nextest >/dev/null 2>&1 || { echo 'test: cargo-nextest is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo nextest run --workspace --no-fail-fast --status-level fail --final-status-level fail || { echo 'test: a test failed, or the suite is empty' >&2; exit 1; }"
  }
  ["tdd-order"] {
    glob = List("**/*.rs", "dev/tdd-order.exempt")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'tdd-order: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo run -q -p chertmem-dev -- tdd-order || { echo 'tdd-order: a commit adds Rust code with no test: commit before it in the push range' >&2; exit 1; }"
  }
  ["coverage"] {
    glob = List("**/*.rs", "Cargo.toml", ".coverage")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'coverage: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd coverage --check || { echo 'coverage: line coverage fell below .coverage' >&2; exit 1; }"
  }
  ["bench-gate"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock", "benches/baseline.toml")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'bench-gate: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo bench -q -p chertmem --bench latency -- '/10?k-p52$' && cargo run -q -p chertmem-dev -- bench-gate 1k-p52 10k-p52 || { echo 'bench-gate: a bench median is over its baseline x (1 + tolerance) on this machine class; see docs/BENCHMARKS.md' >&2; exit 1; }"
  }
}
