amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

// Every hook's steps: the generated ones, shaped so `cargo run` never races.
local fast = (generated.steps) {
  // dev V10, B2, B3 (lablith and actlith B9): cargo replaces
  // target/debug/chertmem-dev's hard link on EVERY `cargo run`, even when
  // nothing is rebuilt, so two such steps at once race: one execs a path
  // the other just unlinked. Each runs alone (`exclusive`) and builds what
  // it needs while nothing else runs.
  ["name-guard"] { exclusive = true }
  ["no-core-worktree"] { exclusive = true }
  ["lock-graph"] { exclusive = true }
  ["rust-mirror"] { exclusive = true }
  ["perf-doc"] { exclusive = true }
  ["package-list"] { exclusive = true }
  // dev T10: `notices` runs cargo tree and metadata --offline, so it
  // waits for clippy, whose build fills the cargo registry first (as
  // rekall orders its own notices step).
  ["notices"] {
    exclusive = true
    depends = List("clippy")
  }
}

local all = (fast) {
  // `cargo nextest run --workspace` relinks the binaries too, so `test`
  // runs alone as well (lablith and actlith B10).
  ["test"] = (generated.push["test"]) { exclusive = true }
  ["tdd-order"] = (generated.push["tdd-order"]) { exclusive = true }
  ["coverage"] = (generated.push["coverage"]) { exclusive = true }
  // dev T2: the release bench must run alone, or its medians measure the
  // other steps; it is a `cargo bench` and a `cargo run` too (dev V10).
  ["bench-gate"] = (generated.push["bench-gate"]) { exclusive = true }
  // Root T12, as lablith: no dependency with a published advisory. It
  // fetches the advisory database, so it runs at push and in CI, which
  // reach the network anyway; the commit-time `deny` step stays offline.
  ["deny-advisories"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    check = "cargo deny check advisories"
  }
}

hooks {
  ["pre-commit"] {
    // Check only, never stash (paradigm/V15): the git stash is shared by
    // every worktree, and `sherd wave` (root T8) runs parallel workers in
    // worktrees, so one hook could pop another checkout's files. Without a
    // stash a fixer would rewrite unstaged edits, so fixing stays `hk fix`.
    fix = false
    stash = "none"
    steps = fast
  }
  // dev V11, B4: the message git hands the hook. Both steps run alone
  // (dev V10): each is a `cargo run`.
  ["commit-msg"] {
    steps {
      ["commit-msg"] {
        check = "cargo run -q -p chertmem-dev -- commit-msg {{commit_msg_file}}"
        exclusive = true
      }
      // The message is committed text too; the same guard reads it.
      ["message-names"] {
        check = "cargo run -q -p chertmem-dev -- name-guard {{commit_msg_file}}"
        exclusive = true
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    // hk 2.x stages fixes only in pre-commit unless a hook asks for it.
    stage = true
    steps = all
  }
}
