amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

// Every hook's steps: the generated ones, ordered so `cargo run` never races.
local fast = (generated.steps) {
  // dev V9, B2 (lablith and actlith B9): every step that runs `cargo run`
  // waits for this build. Started together on a stale binary, one cargo
  // relinks the executable while another is starting it, and macOS kills
  // that process with no output: a gate step that fails for no reason.
  // Built once first, every later `cargo run` finds it fresh.
  ["build"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
    check = "cargo build -q --workspace --bins"
    depends = List("clippy")
  }
  ["name-guard"] { depends = List("build") }
  ["no-core-worktree"] { depends = List("build") }
  ["lock-graph"] { depends = List("build") }
}

local all = (fast) {
  // `cargo nextest run --workspace` relinks the binaries too, so `test`
  // waits for every `cargo run` step (lablith and actlith B10).
  ["test"] = (generated.push["test"]) {
    depends = List("name-guard", "no-core-worktree", "lock-graph")
  }
}

hooks {
  ["pre-commit"] {
    // Check only, never stash (paradigm/V15): the git stash is shared by
    // every worktree, and `sherd wave` (root T8) runs parallel workers in
    // worktrees, so one hook could pop another checkout's files. Without a
    // stash a fixer would rewrite unstaged edits, so fixing stays `hk fix`.
    fix = false
    stash = "none"
    steps = fast
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    // hk 2.x stages fixes only in pre-commit unless a hook asks for it.
    stage = true
    steps = all
  }
}
